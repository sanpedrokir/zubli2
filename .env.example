# Zubli Reconnect — environment variables
# Copy this file to .env.local and fill in your own values.
# NEVER commit real keys. .env.local is git-ignored.

# --- Neon PostgreSQL (required) --------------------------------------------
# Neon console → your project → Connection Details → "Pooled connection".
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-123456-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# --- Clerk authentication (required) ---------------------------------------
# Clerk dashboard → API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME

# Keep Clerk's sign-in/sign-up on this site's own pages.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# --- Memory-inspired illustrations (optional) ------------------------------
# Leave IMAGE_API_KEY empty to turn the feature off. Any OpenAI-compatible
# Images API works (POST {IMAGE_API_BASE_URL}/images/generations).
IMAGE_API_KEY=
IMAGE_API_BASE_URL=https://api.openai.com/v1
IMAGE_MODEL=gpt-image-1
# low | medium | high (cost/quality trade-off)
IMAGE_QUALITY=medium
# Optional site-wide cap on illustrations per day (protects your API budget).
ILLUSTRATION_GLOBAL_DAILY_LIMIT=100
